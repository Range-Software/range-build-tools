<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Mandatory for the Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Range Cloud sessions, the AI assistant and the update check. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Models, materials and screenshots opened or saved through a file dialog. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Reports and model documents are printable. -->
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>
