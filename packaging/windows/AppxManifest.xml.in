<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest for @PROJECT_HUMAN_NAME@.
     Generated by CMake - do not edit directly, modify AppxManifest.xml.in instead.

     Identity/@Name and Identity/@Publisher must match the values reserved for the
     application in Partner Center, otherwise the Store rejects the upload. -->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

    <Identity
        Name="@MSIX_IDENTITY_NAME@"
        Publisher="@MSIX_PUBLISHER@"
        Version="@MSIX_PACKAGE_VERSION@"
        ProcessorArchitecture="@MSIX_ARCHITECTURE@" />

    <Properties>
        <DisplayName>@PROJECT_HUMAN_NAME@</DisplayName>
        <PublisherDisplayName>@MSIX_PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
        <Description>@PROJECT_DESCRIPTION@ - @PROJECT_TITLE@</Description>
        <Logo>assets\StoreLogo.png</Logo>
    </Properties>

    <Dependencies>
        <!-- 10.0.17763.0 is the first release supporting packaged desktop applications
             with the full set of MSIX features used here. -->
        <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
    </Dependencies>

    <Resources>
        <Resource Language="en-us" />
        <Resource Language="sk-sk" />
    </Resources>

    <Applications>
        <Application Id="@MSIX_APPLICATION_ID@" Executable="bin\@MSIX_EXECUTABLE_NAME@.exe" EntryPoint="Windows.FullTrustApplication">
            <uap:VisualElements
                DisplayName="@PROJECT_HUMAN_NAME@"
                Description="@PROJECT_DESCRIPTION@ - @PROJECT_TITLE@"
                BackgroundColor="transparent"
                Square150x150Logo="assets\Square150x150Logo.png"
                Square44x44Logo="assets\Square44x44Logo.png">
                <uap:DefaultTile
                    ShortName="@PROJECT_SHORT_NAME@"
                    Square71x71Logo="assets\Square71x71Logo.png"
                    Square310x310Logo="assets\Square310x310Logo.png">
                    <uap:ShowNameOnTiles>
                        <uap:ShowOn Tile="square150x150Logo" />
                        <uap:ShowOn Tile="square310x310Logo" />
                    </uap:ShowNameOnTiles>
                </uap:DefaultTile>
            </uap:VisualElements>
        </Application>
    </Applications>

    <Capabilities>
        <!-- Desktop bridge: the application keeps running as a normal Win32 process. -->
        <rescap:Capability Name="runFullTrust" />
    </Capabilities>

</Package>
